# Java and JNI

find_package(Java 1.8)

set(JAVA_AWT_LIBRARY NotNeeded)
set(JAVA_JVM_LIBRARY NotNeeded)

find_package(JNI)

cmake_minimum_required(VERSION 3.5...3.29)
set(CMAKE_CXX_STANDARD "11" CACHE STRING "C++ standard to enforce")
set(CMAKE_VERBOSE_MAKEFILE OFF)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")

option(ENABLE_ADDRESS_SANITIZER "Enable address sanitizer." FALSE)

if(NOT JNI_FOUND OR NOT Java_FOUND)
  message(FATAL_ERROR "No compatible Java/JNI found")
endif()

if(NOT(Java_VERSION_MAJOR STREQUAL "1" AND Java_VERSION_MINOR STREQUAL "8"))
  message(WARNING "JDK ${Java_VERSION} is used to compile the Java part of the driver, resulting binaries will NOT be compatible with JDK 8.")
endif()

include(UseJava)


# project definition

project(HaybarnJava C CXX Java)

if (NOT CMAKE_BUILD_TYPE OR CMAKE_BUILD_TYPE STREQUAL "")
    set(CMAKE_BUILD_TYPE "Release" CACHE STRING "" FORCE)
endif()


# Haybarn: stamp the embedded engine's release version explicitly.
#
# vendor.py bakes whatever `git describe` produced for the engine checkout into
# src/duckdb/.../pragma_version.cpp. For an rc engine tag that resolves to a
# "-dev" string (e.g. v1.5.4-dev128, 128 commits past the upstream v1.5.3 base).
# DuckDB's extension loader treats any version containing "-dev" as a non-release
# and resolves extensions from
#   <repo>/core/<git-source-id>/<platform>/...   (e.g. .../core/c6674f9baf/...)
# instead of
#   <repo>/core/<version>/<platform>/...         (e.g. .../core/v1.5.3/...)
# Haybarn publishes extensions under the release version (v1.5.3) even for rc
# engine builds, so the source-id path 404s. Override DUCKDB_VERSION (the value
# DuckDB::LibraryVersion() returns) to the release version so IsRelease() is true
# and the extension path uses v1.5.3. pragma_version.cpp guards each #define with
# #ifndef, so these compile-time definitions win; the vendored DUCKDB_SOURCE_ID
# is left intact for traceability. Bump this in lockstep with the engine release.
set(HAYBARN_ENGINE_VERSION "v1.5.3"
    CACHE STRING "Release version stamped into the embedded Haybarn engine")
string(REGEX REPLACE "^v" "" HAYBARN_ENGINE_VERSION_NUM "${HAYBARN_ENGINE_VERSION}")
string(REPLACE "." ";" HAYBARN_ENGINE_VERSION_PARTS "${HAYBARN_ENGINE_VERSION_NUM}")
list(GET HAYBARN_ENGINE_VERSION_PARTS 0 HAYBARN_ENGINE_VERSION_MAJOR)
list(GET HAYBARN_ENGINE_VERSION_PARTS 1 HAYBARN_ENGINE_VERSION_MINOR)
list(GET HAYBARN_ENGINE_VERSION_PARTS 2 HAYBARN_ENGINE_VERSION_PATCH)


# variables set by vendor.py

set(DUCKDB_INCLUDE_DIRS
  ${INCLUDES})

set(JEMALLOC_INCLUDE_DIRS
  ${JEMALLOC_INCLUDES})

set(DUCKDB_DEFINITIONS
  ${DEFINES})

set(DUCKDB_SRC_FILES 
  ${SOURCES})

set(JEMALLOC_SRC_FILES 
  ${JEMALLOC_SOURCES})


# a few OS-specific variables

set(OS_NAME "unknown")
set(OS_ARCH "amd64")

string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" SYSTEM_PROCESSOR_LOWER)
string(REGEX MATCH "(arm64|aarch64)" IS_ARM "${SYSTEM_PROCESSOR_LOWER}")
if(IS_ARM)
  set(OS_ARCH "arm64")
elseif(FORCE_32_BIT)
  set(OS_ARCH "i386")
endif()

if(APPLE)
  set(OS_NAME "osx")
  set(OS_ARCH "universal")
  SET(CMAKE_OSX_ARCHITECTURES "x86_64;arm64" CACHE STRING "Build architectures for Mac OS X" FORCE)
endif()
if(WIN32)
  set(OS_NAME "windows")
endif()
if(UNIX AND NOT APPLE)
  set(OS_NAME "linux") # sorry BSD
endif()

if(OVERRIDE_JDBC_OS_NAME)
  set(OS_NAME ${OVERRIDE_JDBC_OS_NAME})
endif()

if(OVERRIDE_JDBC_OS_ARCH)
  set(OS_ARCH ${OVERRIDE_JDBC_OS_ARCH})
endif()


# Java compilation

file(GLOB_RECURSE JAVA_SRC_FILES src/main/java/farm/query/haybarn/*.java)
file(GLOB_RECURSE JAVA_TEST_FILES src/test/java/farm/query/haybarn/*.java)
set(CMAKE_JAVA_COMPILE_FLAGS -encoding utf-8 -g -Xlint:all)

add_jar(haybarn_jdbc_nolib ${JAVA_SRC_FILES} META-INF/services/java.sql.Driver
        MANIFEST META-INF/MANIFEST.MF
        GENERATE_NATIVE_HEADERS duckdb-native)
add_jar(haybarn_jdbc_tests ${JAVA_TEST_FILES} INCLUDE_JARS haybarn_jdbc_nolib)


# main shared lib compilation

if(MSVC OR ZOS)
  list(APPEND DUCKDB_INCLUDE_DIRS src/stubs)
  list(APPEND DUCKDB_SRC_FILES haybarn_java.def)
else()
  list(APPEND DUCKDB_SRC_FILES ${JEMALLOC_SRC_FILES})
endif()

add_library(haybarn_java SHARED
  src/jni/bindings_appender.cpp
  src/jni/bindings_common.cpp
  src/jni/bindings_data_chunk.cpp
  src/jni/bindings_logical_type.cpp
  src/jni/bindings_result.cpp
  src/jni/bindings_scalar_function.cpp
  src/jni/bindings_table_function.cpp
  src/jni/bindings_table_function_bind.cpp
  src/jni/bindings_table_function_init.cpp
  src/jni/bindings_validity.cpp
  src/jni/bindings_vector.cpp
  src/jni/bindings_value.cpp
  src/jni/config.cpp
  src/jni/haybarn_java.cpp
  src/jni/functions.cpp
  src/jni/holders.cpp
  src/jni/refs.cpp
  src/jni/types.cpp
  src/jni/util.cpp
  ${DUCKDB_SRC_FILES})

target_include_directories(haybarn_java PRIVATE
  ${JAVA_INCLUDE_PATH}
  ${JAVA_INCLUDE_PATH2}
  ${DUCKDB_INCLUDE_DIRS})

if (NOT MSVC AND NOT ZOS)
  target_include_directories(haybarn_java PRIVATE
    ${JEMALLOC_INCLUDE_DIRS})
endif()

target_link_libraries(haybarn_java PRIVATE
  duckdb-native
  ${CMAKE_DL_LIBS})

if(MSVC)
  target_link_libraries(haybarn_java PRIVATE
    ws2_32
    rstrtmgr
    bcrypt)
endif()

if(MSVC)
  target_compile_options(haybarn_java PRIVATE
    /bigobj)
else()
  target_compile_options(haybarn_java PRIVATE
    -fexceptions)
endif()

target_compile_definitions(haybarn_java PRIVATE
  ${DUCKDB_DEFINITIONS}
  -DDUCKDB_BUILD_LIBRARY
  -DDUCKDB_STATIC_BUILD
  -DDUCKDB_EXTENSION_AUTOLOAD_DEFAULT
  -DDUCKDB_EXTENSION_AUTOINSTALL_DEFAULT
  "-DDUCKDB_VERSION=\"${HAYBARN_ENGINE_VERSION}\""
  -DDUCKDB_MAJOR_VERSION=${HAYBARN_ENGINE_VERSION_MAJOR}
  -DDUCKDB_MINOR_VERSION=${HAYBARN_ENGINE_VERSION_MINOR}
  "-DDUCKDB_PATCH_VERSION=\"${HAYBARN_ENGINE_VERSION_PATCH}\"")

if(NOT MSVC AND NOT ZOS)
  target_compile_definitions(haybarn_java PRIVATE
    -DDUCKDB_ENABLE_JEMALLOC)
endif()

if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
  target_link_options(haybarn_java PRIVATE
    -Bsymbolic
    -Bsymbolic-functions
    -fvisibility=hidden 
    -Wl,--version-script=${CMAKE_CURRENT_LIST_DIR}/haybarn_java.map)
elseif(CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang")
  target_link_options(haybarn_java PRIVATE
    -fvisibility=hidden
    -Wl,-exported_symbols_list,${CMAKE_CURRENT_LIST_DIR}/haybarn_java.exp)
endif()

if(${ENABLE_ADDRESS_SANITIZER})
  message(STATUS "Address Sanitizer is enabled, run with LD_PRELOAD=\"/path/to/libasan.so.8 /path/to/libstdc++.so.6\"")
  target_compile_options(haybarn_java PRIVATE
    -fsanitize=address
    -g
    -fno-omit-frame-pointer)
  if(CMAKE_BUILD_TYPE STREQUAL "Release")
    target_compile_options(haybarn_java PRIVATE
      -O2)
  endif()
endif()

string(JOIN "_" LIB_SUFFIX ".so" ${OS_NAME} ${OS_ARCH})
set_target_properties(haybarn_java PROPERTIES SUFFIX ${LIB_SUFFIX})
set_target_properties(haybarn_java PROPERTIES PREFIX "lib")


# JAR packing

add_custom_command(
  OUTPUT dummy_jdbc_target
  DEPENDS haybarn_java haybarn_jdbc_nolib haybarn_jdbc_tests
  COMMAND ${CMAKE_COMMAND} -E copy
          haybarn_jdbc_nolib.jar
          haybarn_jdbc.jar
  COMMAND ${Java_JAR_EXECUTABLE} uf haybarn_jdbc.jar -C
          $<TARGET_FILE_DIR:haybarn_java> $<TARGET_FILE_NAME:haybarn_java>)

add_custom_target(jdbc ALL DEPENDS dummy_jdbc_target)

# test resources

configure_file(
  src/test/external/spark-session-init.sql
  spark-session-init.sql)
configure_file(
  src/test/external/spark-test.sql
  spark-test.sql)
